; English strings for DarkSoulsItemRandomizer-Setup.nsi
; To add a language: copy English.nsh, translate, and add it to LANGUAGES in the main script.

LangString TXT_WelcomeText   ${LANG_ENGLISH} "This will install the Dark Souls Item Randomizer by HotPocketRemix into your Dark Souls: Remastered folder and create shortcuts to run it.$\r$\n$\r$\nIMPORTANT - PLAY OFFLINE!$\r$\nBefore going back online, delete any character that used the randomizer and restore the original items (uninstalling does it for you). Otherwise you risk anti-cheat detection and a ban.$\r$\n$\r$\nOnly randomize at the START of a playthrough, never in the middle."
LangString TXT_DirTop        ${LANG_ENGLISH} "Select your Dark Souls folder: the one containing DarkSoulsRemastered.exe (or DARKSOULS.exe for an unpacked Prepare to Die Edition). The installer tried to detect it through Steam."
LangString TXT_DirDest       ${LANG_ENGLISH} "Dark Souls folder"
LangString TXT_BadDir        ${LANG_ENGLISH} "This doesn't look like a Dark Souls folder.$\r$\n$\r$\nExpected to find DarkSoulsRemastered.exe (or DARKSOULS.exe) and$\r$\n${GP_DIR}\GameParam.parambnd.dcx (or .parambnd)$\r$\n$\r$\nTip: in Steam, right-click the game > Manage > Browse local files, and copy that path here."
LangString TXT_PtdePacked    ${LANG_ENGLISH} "DARKSOULS.exe (Prepare to Die Edition) was found, but the game files are not unpacked: ${GP_DIR}\GameParam.parambnd is missing.$\r$\n$\r$\nRun UnpackDarkSoulsForModding first:$\r$\nhttps://github.com/HotPocketRemix/UnpackDarkSoulsForModding"
LangString TXT_RunNow        ${LANG_ENGLISH} "Launch the randomizer now"
LangString TXT_FinishText    ${LANG_ENGLISH} "Open the randomizer, pick your options and click $\"Scramble Items && Export$\". A backup of the original file is made automatically.$\r$\n$\r$\nTo get the original items back: $\"Restore original items$\" shortcut, or uninstall."
LangString SEC_Core_Name     ${LANG_ENGLISH} "Randomizer (required)"
LangString SEC_StartM_Name   ${LANG_ENGLISH} "Start Menu shortcuts"
LangString SEC_Desktop_Name  ${LANG_ENGLISH} "Desktop shortcut"
LangString LNK_Restore       ${LANG_ENGLISH} "Restore original items"
LangString LNK_Folder        ${LANG_ENGLISH} "Open game folder (cheatsheets)"
LangString LNK_Uninst        ${LANG_ENGLISH} "Uninstall randomizer"
LangString UN_Restored       ${LANG_ENGLISH} "Original items restored from the backup."
LangString UN_NoBak          ${LANG_ENGLISH} "No GameParam backup (.bak) was found, so nothing was restored. If you had randomized the game, use Steam > Properties > Installed Files > Verify integrity of game files."
LangString UN_RestoreFail    ${LANG_ENGLISH} "Could not restore GameParam: the file is in use (is Dark Souls running?). Close the game and try again."
LangString UN_AskSeeds       ${LANG_ENGLISH} "Also delete the generated $\"random-seed-...$\" folders (cheatsheets, hint sheets, seed info) from the game folder?"
LangString UN_Reminder       ${LANG_ENGLISH} "Reminder: before playing online, delete the characters you played with the randomizer (save files are in Documents\NBGI)."
LangString SEC_Firewall_Name ${LANG_ENGLISH} "Block the game online (Windows Firewall)"
LangString TXT_OffTitle      ${LANG_ENGLISH} "Play offline safely"
LangString TXT_OffSub        ${LANG_ENGLISH} "How to avoid online penalties."
LangString TXT_OffBody       ${LANG_ENGLISH} "The randomizer changes your game files, so the game must never connect to FromSoftware's servers while you use it.$\r$\n$\r$\n1. Windows Firewall: on the next page the installer can block Dark Souls from going online. The block is removed only when you uninstall.$\r$\n$\r$\n2. In game: at the title screen go to System > Network Settings > Launch Setting and choose $\"Start Offline$\".$\r$\n$\r$\n3. Steam Cloud: Steam still syncs your randomized save. Turn off Steam Cloud for Dark Souls: Remastered (game Properties > General), or delete the randomized characters before playing online on any PC."
LangString TXT_FwFail        ${LANG_ENGLISH} "Could not add the Windows Firewall rule. The game is NOT blocked: choose $\"Start Offline$\" in the game's Network Settings, or block DarkSoulsRemastered.exe in your firewall manually."
